# ===========================================
# Python Virtual Environment Settings
# ===========================================
VENV_DIR=.venv
REQ_FILE=requirements.txt

# ===========================================
# FastAPI Server Configuration
# ===========================================
API_HOST=localhost
API_PORT=8000
API_RELOAD_DIR=API

# ===========================================
# PostgreSQL Database Configuration
# ===========================================
DB_NAME=course_gpt
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
SCHEMA_FILE=DB/schema_database.sql
SEED_FILE=DB/seed_database.sql
EXPORT_OLD_DATA_SCRIPT=DB/export_old_data.sql
LOAD_OLD_DATA_SCRIPT=DB/old_data_dump.sql
IMPORT_OLD_DATA_SCRIPT=DB/import_old_data.sql

# ===========================================
# Chroma Vector Database Configuration
# ===========================================
CHROMA_DATA_PATH=.chroma_data

# ===========================================
# JWT Authentication Settings
# ===========================================
# To generate a secure secret key in Python:
# >>> import secrets; print(secrets.token_hex(32))
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# ===========================================
# LLM Provider Configuration
# ===========================================
# LLM_PROVIDER determines which Large Language Model backend to use.
#
# Supported values:
#   - chathuggingface : Uses HuggingFace Inference API or HF Endpoints.
#                       Requires: LLM_MODEL, HUGGINGFACEHUB_API_TOKEN
#
#   - ollama          : Uses a local/self-hosted Ollama server.
#                       Requires: LLM_MODEL, LLM_BASE_URL
#
# Examples:
#   LLM_PROVIDER=chathuggingface
#   LLM_MODEL=deepseek-ai/DeepSeek-R1-0528
#   HUGGINGFACEHUB_API_TOKEN=your_hf_token
#
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3
#   LLM_BASE_URL=http://localhost:11434
#
# Set one provider and fill in the corresponding values below.
LLM_PROVIDER=
LLM_MODEL=
HUGGINGFACEHUB_API_TOKEN=
LLM_BASE_URL=